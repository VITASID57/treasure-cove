{
  "schemaVersion": 2,
  "appId": "lumenkeep-mimi-town",
  "version": "0.4.0",
  "name": "栖光庭",
  "icon": null,
  "requestedCapabilities": [
    "resident-read",
    "network"
  ],
  "contributions": {
    "page": {
      "entryHtml": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>栖光庭</title>\n  <style>\n    :root { color-scheme: light; --surface: #fff; --text: #24342e; --border: #bac6be; --accent: #567564; }\n    * { box-sizing: border-box; }\n    [hidden] { display: none !important; }\n    body { margin: 0; background: var(--surface); color: var(--text); font: 15px/1.55 system-ui, sans-serif; }\n    main { max-width: 34rem; margin-inline: auto; padding: 16px; }\n    h2 { margin: 0; font-size: 18px; line-height: 1.4; }\n    p { margin: 0; overflow-wrap: anywhere; }\n    section { display: grid; gap: 12px; }\n    section + section { margin-top: 18px; padding-top: 18px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }\n    .field { display: grid; gap: 5px; min-width: 0; }\n    input, button { min-height: 44px; border: 1px solid var(--border); border-radius: 9px; font: inherit; color: inherit; }\n    input { width: 100%; padding: 8px 10px; background: var(--surface); font-size: 16px; }\n    button { padding: 8px 14px; border-color: transparent; background: color-mix(in srgb, var(--accent) 9%, var(--surface)); cursor: pointer; }\n    button.primary { background: var(--accent); color: #fff; font-weight: 650; }\n    button:disabled { opacity: .65; cursor: default; }\n    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n    .connection-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }\n    .connection-heading p { font-size: 14px; color: var(--accent); }\n    .actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr)); gap: 8px; }\n    .actions button.primary { grid-column: 1 / -1; }\n    footer { display: grid; justify-items: start; gap: 4px; padding: 15px 2px 0; font-size: 14px; }\n    footer button { min-height: 0; padding: 0; background: none; text-decoration: underline; text-underline-offset: 3px; }\n  </style>\n</head>\n<body>\n  <main>\n    <section aria-labelledby=\"connection-title\">\n      <div class=\"connection-heading\">\n        <h2 id=\"connection-title\">连接栖光庭</h2>\n        <p id=\"connection-status\" role=\"status\">正在载入…</p>\n      </div>\n      <label class=\"field\" for=\"address\" id=\"address-field\">栖光庭地址<input id=\"address\" type=\"url\" inputmode=\"url\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" disabled></label>\n      <label class=\"field\" for=\"token\" id=\"token-field\" hidden>小镇导入口令<input id=\"token\" type=\"password\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\"></label>\n      <div class=\"actions\">\n        <button type=\"button\" id=\"connect\" class=\"primary\" disabled>连接</button>\n        <button type=\"button\" id=\"open-settings\" hidden>打开栖光庭</button>\n        <button type=\"button\" id=\"change-address\" hidden>更换地址</button>\n        <button type=\"button\" id=\"forget-token\" hidden>忘记口令</button>\n      </div>\n    </section>\n    <section aria-label=\"人设\">\n      <button type=\"button\" id=\"sync\" class=\"primary\" disabled>从小镇导入人设</button>\n      <p id=\"sync-status\" role=\"status\" hidden></p>\n      <button type=\"button\" id=\"open-profile\" hidden>打开人物档案</button>\n    </section>\n    <footer id=\"deployment\">\n      <p>栖光庭需要部署在常在线的电脑或云服务器上。</p>\n      <button type=\"button\" id=\"open-guide\" disabled>部署说明</button>\n    </footer>\n  </main>\n  <script>\n    const byId = id => document.getElementById(id);\n    const address = byId('address');\n    const token = byId('token');\n    const connect = byId('connect');\n    const sync = byId('sync');\n    const guide = byId('open-guide');\n    const settings = byId('open-settings');\n    const changeAddress = byId('change-address');\n    const forgetToken = byId('forget-token');\n    const profile = byId('open-profile');\n    const connectionStatus = byId('connection-status');\n    const syncStatus = byId('sync-status');\n    const guideUrl = new URL('https://github.com/VITASID57/tg-wechat-agent-steward/blob/main/docs/deployment.md');\n    const api = '/api/integrations/mimi-town';\n    let allowed = [];\n    let connected = false;\n    let busy = false;\n    let profileId = '';\n    let saved = { address: '', token: '' };\n\n    function originFromInput() {\n      try {\n        const url = new URL(address.value.trim());\n        if (['http:', 'https:'].includes(url.protocol) && !url.username && !url.password\n          && url.pathname === '/' && !url.search && !url.hash) return url.origin;\n      } catch {}\n      return '';\n    }\n\n    function render() {\n      const approved = allowed.includes(originFromInput());\n      byId('address-field').hidden = connected;\n      byId('token-field').hidden = !approved || connected;\n      byId('deployment').hidden = approved;\n      settings.hidden = !approved;\n      changeAddress.hidden = !connected;\n      forgetToken.hidden = !saved.token;\n      connect.textContent = connected ? '重新检查' : '连接';\n      connect.classList.toggle('primary', !connected);\n      address.disabled = token.disabled = connect.disabled = guide.disabled = settings.disabled = changeAddress.disabled = busy;\n      forgetToken.disabled = busy;\n      sync.disabled = busy || !connected;\n      profile.hidden = !profileId || !approved;\n    }\n\n    function showSync(message) {\n      syncStatus.textContent = message;\n      syncStatus.hidden = !message;\n    }\n\n    function resetConnection(clearToken = false) {\n      connected = false;\n      profileId = '';\n      if (clearToken) token.value = '';\n      showSync('');\n      connectionStatus.textContent = '未连接';\n      render();\n    }\n\n    async function saveConnection(origin, importToken = '') {\n      if (saved.address === origin && saved.token === importToken) return;\n      await mimiTown.storage.set(importToken ? { address: origin, token: importToken } : { address: origin });\n      saved = { address: origin, token: importToken };\n    }\n\n    async function request(origin, path, importToken, payload) {\n      const response = await fetch(`${origin}${api}${path}`, {\n        method: payload ? 'POST' : 'GET',\n        headers: payload ? { Authorization: `Bearer ${importToken}`, 'Content-Type': 'application/json' }\n          : { Authorization: `Bearer ${importToken}` },\n        body: payload ? JSON.stringify(payload) : undefined,\n        cache: 'no-store', credentials: 'omit', redirect: 'error', signal: AbortSignal.timeout(12000),\n      });\n      if (!response.ok) throw Object.assign(new Error('请求失败'), { status: response.status });\n      return await response.json();\n    }\n\n    async function showConnectionError(error, origin) {\n      connected = false;\n      if (error.status !== 401) {\n        connectionStatus.textContent = '连不上栖光庭，请检查地址和网络。';\n        return;\n      }\n      token.value = '';\n      profileId = '';\n      showSync('');\n      connectionStatus.textContent = '口令不对';\n      if (saved.address === origin) {\n        try { await saveConnection(origin); }\n        catch { connectionStatus.textContent = '口令不对，未能清除已保存的口令。'; }\n      }\n    }\n\n    async function checkConnection(origin, importToken) {\n      try {\n        const result = await request(origin, '/status', importToken);\n        if (result.ok !== true) throw new Error('状态接口响应不正确');\n        connected = true;\n        connectionStatus.textContent = '已连上';\n        return true;\n      } catch (error) {\n        await showConnectionError(error, origin);\n        return false;\n      }\n    }\n\n    connect.onclick = async () => {\n      const origin = originFromInput();\n      if (!origin) { connectionStatus.textContent = '请输入有效的栖光庭地址。'; address.focus(); return; }\n      if (allowed.includes(origin) && !token.value.trim()) {\n        connectionStatus.textContent = '请填写小镇导入口令。'; token.focus(); return;\n      }\n      busy = true;\n      connectionStatus.textContent = '正在连接…';\n      render();\n      try {\n        address.value = origin;\n        if (!allowed.includes(origin)) {\n          if (saved.address !== origin) await saveConnection(origin);\n          await mimiTown.network.allow({ origin });\n        } else {\n          const importToken = token.value.trim();\n          if (await checkConnection(origin, importToken)) {\n            try { await saveConnection(origin, importToken); }\n            catch { connectionStatus.textContent = '已连上，口令未保存。'; }\n          }\n        }\n      } catch {\n        connectionStatus.textContent = '连接未授权，请重试。';\n      } finally { busy = false; render(); }\n    };\n\n    sync.onclick = async () => {\n      const origin = originFromInput();\n      const importToken = token.value.trim();\n      busy = true;\n      profileId = '';\n      showSync('');\n      render();\n      try {\n        if (!await checkConnection(origin, importToken)) return;\n        const pack = await mimiTown.residents.readPack({ parts: ['persona'] }).catch(() => null);\n        if (!pack?.persona) { showSync('未导入人设。'); return; }\n        showSync('正在导入…');\n        const { schemaVersion, resident, persona } = pack;\n        const imported = await request(origin, '/profiles', importToken, { schemaVersion, resident, persona });\n        if (!/^profile-[a-z0-9-]+$/.test(imported.id) || typeof imported.name !== 'string') throw new Error('导入响应不正确');\n        profileId = imported.id;\n        showSync(`已在栖光庭新建《${imported.name}》。`);\n      } catch (error) {\n        if (error.status === 401) await showConnectionError(error, origin);\n        else showSync(error.status ? '导入失败，请检查连接后重试。' : '未收到导入结果，请先到栖光庭查看人物档案。');\n      } finally { busy = false; render(); }\n    };\n\n    function open(url, report) {\n      void mimiTown.network.open({ url }).catch(() => report('暂时无法打开网页。'));\n    }\n    settings.onclick = () => open(`${originFromInput()}/#mimi-town-import`, text => { connectionStatus.textContent = text; });\n    profile.onclick = () => open(`${originFromInput()}/#profiles/${profileId}`, showSync);\n    guide.onclick = () => {\n      if (allowed.includes(guideUrl.origin)) {\n        open(guideUrl.href, text => { connectionStatus.textContent = text; });\n      } else {\n        void mimiTown.network.allow({ origin: guideUrl.origin }).catch(() => {\n          connectionStatus.textContent = '请先同意打开部署说明。';\n        });\n      }\n    };\n    address.oninput = () => resetConnection(true);\n    token.oninput = () => resetConnection();\n    changeAddress.onclick = () => { resetConnection(true); address.focus(); };\n    forgetToken.onclick = async () => {\n      busy = true;\n      render();\n      try {\n        await saveConnection(saved.address);\n        resetConnection(true);\n        connectionStatus.textContent = '已忘记口令';\n      } catch { connectionStatus.textContent = '暂时无法忘记口令，请重试。'; }\n      finally { busy = false; render(); }\n    };\n    for (const input of [address, token]) input.onkeydown = event => {\n      if (event.key === 'Enter') { event.preventDefault(); connect.click(); }\n    };\n    document.addEventListener('visibilitychange', async () => {\n      if (document.hidden || !connected || busy) return;\n      busy = true;\n      render();\n      try { await checkConnection(originFromInput(), token.value.trim()); }\n      finally { busy = false; render(); }\n    });\n\n    async function init() {\n      let ready = false;\n      try {\n        const host = await mimiTown.ready();\n        for (const key of ['surface', 'text', 'border', 'accent']) {\n          if (host.theme?.[key]) document.documentElement.style.setProperty(`--${key}`, host.theme[key]);\n        }\n        document.documentElement.style.colorScheme = host.theme?.mode === 'dark' ? 'dark' : 'light';\n        if (host.preview) { connectionStatus.textContent = '安装后即可连接栖光庭。'; return; }\n        allowed = host.network ?? [];\n        const data = await mimiTown.storage.get();\n        ready = true;\n        address.value = typeof data?.address === 'string' ? data.address : '';\n        const origin = originFromInput();\n        saved = { address: origin, token: origin && typeof data?.token === 'string' ? data.token : '' };\n        if (!allowed.includes(origin)) {\n          connectionStatus.textContent = address.value ? '连接未授权' : '未连接';\n        } else if (saved.token) {\n          busy = true;\n          connectionStatus.textContent = '正在连接…';\n          token.value = saved.token;\n          render();\n          await checkConnection(origin, saved.token);\n        } else { connectionStatus.textContent = '请填写小镇导入口令。'; }\n      } catch { connectionStatus.textContent = '暂时无法载入插件，请重新打开。'; }\n      finally { busy = false; if (ready) render(); }\n    }\n    void init();\n  </script>\n</body>\n</html>\n"
    }
  }
}
